# Copy to .env.local to change anything. These stay on the server: the browser never sees the partner key.

# auto   = use the TrueID backend when it's running, otherwise demo mode (default)
# remote = always use the TrueID backend
# local  = always use demo mode (built-in sample verdicts, no backend needed)
TRUEID_MODE=auto
TRUEID_API_URL=http://127.0.0.1:8000
TRUEID_PARTNER_KEY=pl_test_41d8e0c6aa27

# Passcode for the operations console at /ops
OPS_PASSCODE=paylite-ops
